# Токен бота від @BotFather
BOT_TOKEN=

# Ваш Telegram ID (бот покаже його у відповідь на /start)
OWNER_ID=

# Ключ Claude API для підсумків: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Sheets (необов'язково)
# Шлях до JSON-ключа сервісного акаунта Google
GOOGLE_CREDENTIALS_FILE=google-credentials.json
# ID таблиці — частина посилання між /d/ і /edit
GOOGLE_SPREADSHEET_ID=

# Файл бази даних
DB_PATH=messages.db
